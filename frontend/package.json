{
  "name": "fresh-mall-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "npm run check:api && npm run typecheck && npm test",
    "import:design": "node scripts/import-design.mjs",
    "dev": "npm run import:design && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run import:design && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "node scripts/e2e-demo.mjs",
    "test:ui": "node scripts/verify-design-r04.mjs",
    "gallery": "node ../scripts/build-design-gallery.mjs"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "openapi-typescript": "7.13.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
