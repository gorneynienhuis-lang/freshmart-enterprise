# Documentation only. Do not copy placeholder values into a running deployment.
# Generate the real local configuration with scripts/deploy-public.py init.
COMPOSE_PROJECT_NAME=freshmall
SITE_HOST=your-domain.example
PUBLIC_ORIGIN=https://your-domain.example
ACME_EMAIL=you@example.org
RELEASE_ID=replace-with-reviewed-git-commit
# lock-images resolves the reviewed official patch tags into immutable digests.
JAVA_BUILD_IMAGE=REQUIRED_REPOSITORY_AT_SHA256_DIGEST
JAVA_RUNTIME_IMAGE=REQUIRED_REPOSITORY_AT_SHA256_DIGEST
NODE_BUILD_IMAGE=REQUIRED_REPOSITORY_AT_SHA256_DIGEST
CADDY_IMAGE=REQUIRED_REPOSITORY_AT_SHA256_DIGEST
MYSQL_IMAGE=REQUIRED_REPOSITORY_AT_SHA256_DIGEST
# No passwords or JWT/sandbox secrets are supplied here. init creates deploy/private/ (0700).
