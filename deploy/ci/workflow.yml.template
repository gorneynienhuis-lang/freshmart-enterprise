# Review template only. Root must approve/install it into .github/workflows separately.
name: FreshMall verify
"on":
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      containers:
        description: Run isolated Linux container and volume-persistence smoke test
        type: boolean
        default: false
permissions:
  contents: read
concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true
jobs:
  verify:
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: '26.12.0'
          package-manager-cache: false
      - uses: actions/setup-java@b843ebf9b913146b38da2eaa7aeddf76074ae1ad # v6.1.0
        with:
          distribution: temurin
          java-version: '21.0.12.1+1'
          check-latest: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.14.7'
      - name: Parse and inspect review template
        run: python3 deploy/ci/check.py
      - name: Contract, fresh dependencies, types, tests, build and backend coverage
        run: python3 deploy/ci/verify.py --scope all --execute
      - name: Preserve bounded test evidence on success or failure
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: checks-${{ github.run_id }}-${{ github.run_attempt }}
          path: deploy/ci/reports/
          retention-days: 7
          if-no-files-found: warn
          include-hidden-files: false
  containers:
    if: github.event_name == 'workflow_dispatch' && inputs.containers
    needs: verify
    runs-on: ubuntu-24.04
    timeout-minutes: 35
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97
        with:
          python-version: '3.14.7'
      - name: Real immutable-image build, health and database volume persistence
        run: python3 deploy/ci/container_smoke.py --execute
      - name: Preserve sanitized owned-container evidence
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: containers-${{ github.run_id }}-${{ github.run_attempt }}
          path: deploy/ci/reports/
          retention-days: 7
          if-no-files-found: warn
          include-hidden-files: false
